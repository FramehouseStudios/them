# Copy this file to them/Release.local.env, fill in real values, then run:
#
#   scripts/run_release_preflight.sh
#
# Do not commit them/Release.local.env. It is ignored by git because it can
# contain release signing and backend secrets.

# Apple Developer Team ID used for signing. Usually 10 characters.
export DEVELOPMENT_TEAM_ID="REPLACE_WITH_APPLE_TEAM_ID"

# Hosted release API URL. Do not use localhost or a tunnel for TestFlight.
export BACKEND_URL="https://api.example.com"

# Production app token accepted by the release backend.
export APP_TOKEN="REPLACE_WITH_PRODUCTION_APP_TOKEN"

# Optional: include backend quality gates as part of the same run.
# Release automation should set this to 1.
export RUN_QUALITY_GATE="1"
