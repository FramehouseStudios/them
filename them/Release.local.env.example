# THEM Release local env template.
#
# Real values belong in the ignored sibling file:
#   them/Release.local.env
#
# Keep this file secret-free. `scripts/run_release_preflight.sh` sources the
# ignored file and stops before App Store preflight if required values are
# missing or invalid.

# 10-character Apple Developer Team ID, for example ABCDE12345.
DEVELOPMENT_TEAM_ID=

# Hosted release API URL. Do not use localhost for Release/TestFlight.
# scripts/run_release_preflight.sh proves this URL with /healthz and
# /api/version before building the release app.
BACKEND_URL=https://api.them.io

# Production X-APP-TOKEN value generated for the hosted backend.
APP_TOKEN_RELEASE=

# Required only for the live story-quality canary in release preflight. This
# stays local and is never copied into the app/Xcode configuration.
OPENAI_API_KEY=

# Canonical public policy page. Preflight rejects redirects and parked pages.
PRIVACY_POLICY_URL=https://them.io/privacy
