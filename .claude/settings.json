{
  "permissions": {
    "deny": [
      "Edit(them/**)",
      "Write(them/**)",
      "Edit(them.xcodeproj/**)",
      "Write(them.xcodeproj/**)",
      "Edit(them.xcworkspace/**)",
      "Write(them.xcworkspace/**)",
      "Edit(AGENTS.md)",
      "Write(AGENTS.md)",
      "Edit(DECISIONS.md)",
      "Write(DECISIONS.md)",
      "Edit(Archive/**)",
      "Write(Archive/**)",
      "Edit(Library/**)",
      "Write(Library/**)",
      "Edit(Projects/**)",
      "Write(Projects/**)",
      "Edit(**/Info-*.plist)",
      "Write(**/Info-*.plist)",
      "Edit(**/*.entitlements)",
      "Write(**/*.entitlements)",
      "Edit(**/PrivacyInfo.xcprivacy)",
      "Write(**/PrivacyInfo.xcprivacy)",
      "Edit(backend/*_store.json)",
      "Write(backend/*_store.json)",
      "Edit(backend/**/knowledge_embeddings_cache.json)",
      "Write(backend/**/knowledge_embeddings_cache.json)"
    ],
    "allow": [
      "Bash(cd backend && npm test*)",
      "Bash(cd backend && npm run *)",
      "Bash(./scripts/quality_gate.sh*)",
      "Bash(RUN_QUALITY_GATE=1 ./scripts/quality_gate.sh*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git worktree list*)"
    ]
  }
}
