# io.them backend — example environment file.
#
# Copy to `.env` for local dev or `.env.production` for production. The
# production runtime refuses to boot without the variables marked
# "REQUIRED" below (see assertProductionEnv in backend/config.js).
# Never commit a real `.env` — `.gitignore` and `.dockerignore` keep
# them out of the repo and out of the image.

# ─── Runtime ─────────────────────────────────────────────────────────
NODE_ENV=development              # development | test | production
PORT=3000
BACKEND_BUILD=dev                 # surfaced via /api/version
# BACKEND_BOOT_ID is generated automatically; do not set manually.

# ─── REQUIRED in production ──────────────────────────────────────────
DATABASE_URL=                     # postgres://user:pass@host:5432/them
JWT_SECRET=                       # 32+ random bytes; rotate on incident
OPENAI_API_KEY=                   # sk-... — no whitespace, no newline
APP_TOKEN=                        # shared secret in X-APP-TOKEN header

# ─── Auth ────────────────────────────────────────────────────────────
JWT_TTL_SECONDS=1209600           # 14 days
AUTH_REFRESH_TTL_SECONDS=2592000  # 30 days
AUTH_PASSWORD_RESET_TTL_SECONDS=3600
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=86400
AUTH_REQUIRE_EMAIL_VERIFIED=false
AUTH_AUTO_VERIFY_EMAILS=false
REQUIRE_USER_AUTH=true            # gate USER_PROTECTED_PATTERNS routes

# Apple Sign In (server-side identity-token verification; required in production)
AUTH_APPLE_AUDIENCE=
# Production verifies Apple tokens against https://appleid.apple.com/auth/keys by kid.
# AUTH_APPLE_JWT_PUBLIC_KEY is a non-production fallback only.
AUTH_APPLE_JWT_PUBLIC_KEY=
# AUTH_APPLE_TEST_JWT_SECRET is ignored in production and only used in dev fixtures.
AUTH_APPLE_TEST_JWT_SECRET=

# ─── Voice / TTS ─────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# TTS_PROVIDER=openai|elevenlabs   # defaults to openai

# ─── CORS / API surface ──────────────────────────────────────────────
CORS_ALLOW_ORIGIN=                # comma-separated; empty = same-origin only
API_SCHEMA_VERSION=1
REQUIRE_APP_TOKEN=                # auto-true when NODE_ENV=production
REQUIRE_CLIENT_TOKEN=             # auto-true when NODE_ENV=production

# ─── Clementine model lanes ──────────────────────────────────────────
CHAT_MODEL_FAST=gpt-4o-mini       # low-latency companion turns
CHAT_MODEL_RICH=gpt-4o            # emotionally nuanced conversation fallback
CHAT_MODEL_KNOWLEDGE=gpt-4o       # substantive knowledge answers
CHAT_STRUCTURAL_REASONING_ENABLED=true
CHAT_MODEL_STRUCTURAL=gpt-5.6-sol # full screenplay pages and bounded repair passes
CHAT_MODEL_STRUCTURAL_FALLBACK=gpt-4o
CHAT_STRUCTURAL_REASONING_EFFORT=low # latency-sensitive first pass
CHAT_SCREENPLAY_REPAIR_REASONING_EFFORT=medium # bounded second pass only
CHAT_STRUCTURAL_TIMEOUT_MS=90000 # deep Studio work only; fast companion turns keep CHAT_TIMEOUT_MS
STRUCTURAL_TURN_SYSTEM_PROMPT_MAX_CHARS=10000
CRAFT_CLASSIFIER_TIMEOUT_MS=10000          # clamped to 15s max per scene
CRAFT_CLASSIFIER_MAX_OUTPUT_TOKENS=160     # clamped to 256 max
CRAFT_CLASSIFIER_FAILURE_THRESHOLD=2       # opens the process-local circuit
CRAFT_CLASSIFIER_CIRCUIT_COOLDOWN_MS=30000

# ─── Idempotency cache (talk + envelope) ─────────────────────────────
TALK_IDEMPOTENCY_ENABLED=true
TALK_IDEMPOTENCY_TTL_MS=600000    # 10 minutes
TALK_IDEMPOTENCY_MAX_ENTRIES=4096

# ─── Outbox worker ───────────────────────────────────────────────────
# OUTBOX_ENABLED=true
# OUTBOX_WORKER_ENABLED=true
# OUTBOX_WORKER_INTERVAL_MS=30000
# Server-only control-plane secret for GET /outbox and POST /outbox/retry.
# Leave unset to disable both HTTP routes. Never ship this value in an app.
# OUTBOX_OPERATOR_TOKEN=          # 32+ random characters

# ─── Runtime lifecycle ──────────────────────────────────────────────
# Grace period for active writer turns and the current outbox tick on SIGTERM.
# SHUTDOWN_GRACE_MS=25000

# ─── Persistence (dev only) ──────────────────────────────────────────
# Leave DATABASE_URL empty in dev to use the JSON adapter. The JSON
# adapter is NOT supported in production — assertProductionEnv refuses
# to boot without DATABASE_URL when NODE_ENV=production.
# PERSISTENCE_JSON_ROOT=

# ─── Observability ───────────────────────────────────────────────────
# Reserved for the structured-logging spec (T-backend-structured-logs).
# LOG_LEVEL=info
# LOG_FORMAT=json
